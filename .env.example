# ============================================================
# 环境变量示例 —— 复制为 .env 后按需修改
# 所有变量均可被 docker-compose.yml 通过 ${VAR} 引用
# ============================================================

# ---------- 基础 ----------
ENV=production
APP_NAME=agent-platform
LOG_LEVEL=INFO

# ---------- LLM（OpenAI 兼容接口，可指向本地部署模型）----------
# 本地大模型示例：base_url=http://host.docker.internal:8000/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
# 是否跳过 API Key 校验（本地模型无需 key 时设为 true）
LLM_SKIP_AUTH=false

# ---------- Embedding（OpenAI 兼容）----------
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=sk-your-key
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
EMBED_SKIP_AUTH=false

# ---------- Rerank（可选；不填则使用 RRF 融合重排）----------
RERANK_ENDPOINT=
RERANK_MODEL=

# ---------- MySQL ----------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=agent
MYSQL_PASSWORD=agent123
MYSQL_DATABASE=agent_platform

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0

# ---------- Milvus ----------
MILVUS_HOST=milvus
MILVUS_PORT=19530

# ---------- Elasticsearch ----------
ES_HOST=http://elasticsearch:9200
ES_USER=elastic
ES_PASSWORD=changeme

# ---------- 鉴权 ----------
AUTH_SECRET=change-me-in-prod
API_KEY_DEFAULT=dev-key-123456

# ---------- 限流（单用户/单 IP 每秒最大请求数）----------
RATE_LIMIT_QPS=5

# ---------- 摄入参数 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80
INGEST_QUEUE=ingest_queue
